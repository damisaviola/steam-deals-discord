# ====================================================================
# Steam Deals Discord Notification - Environment Configuration
# ====================================================================

# [WAJIB] Discord Webhook URL untuk pengiriman notifikasi
# Dapatkan dari Discord: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# [OPSIONAL] Kustomisasi Identitas Bot Discord
DISCORD_USERNAME=Steam Deals Alert
DISCORD_AVATAR_URL=https://upload.wikimedia.org/wikipedia/commons/8/83/Steam_icon_logo.svg
DISCORD_EMBED_COLOR=#1B2838

# [OPSIONAL] Konfigurasi Filter Diskon
# Minimal persentase diskon (1 - 100)
MIN_DISCOUNT=50

# Batas maksimal harga diskon dalam IDR (misal 200000 untuk Rp200.000). Set 0 atau kosong jika tanpa batas.
MAX_PRICE=200000

# Jumlah maksimal game yang dikirim dalam satu eksekusi
MAX_GAMES=10

# Apakah menyertakan game gratis / diskon 100% (true/false)
INCLUDE_FREE_GAMES=false

# [OPSIONAL] Konfigurasi Steam API
STEAM_COUNTRY_CODE=ID
STEAM_LANGUAGE=indonesian
REQUEST_TIMEOUT_MS=10000

# [OPSIONAL] Lokasi File Penyimpanan Riwayat
DEALS_STORAGE_PATH=src/storage/deals.json
